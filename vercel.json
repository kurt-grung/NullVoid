{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "packages/dashboard",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && VITE_BASE=/ npm run dashboard:build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "packages/api",
      "framework": "nitro",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run api:build && cd packages/api && npm run nitro:build:vercel",
      "bindings": [
        { "type": "service", "service": "ml-model", "format": "url", "env": "ML_SERVICE_URL" }
      ]
    },
    "ml-model": {
      "root": "ml-model",
      "framework": "fastapi",
      "entrypoint": "serve:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
