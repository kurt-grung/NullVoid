{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "packages/api",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "cd ../.. && npm run api:build",
      "bindings": [
        { "type": "service", "service": "ml-model", "format": "url", "env": "ML_SERVICE_URL" }
      ]
    },
    "ml-model": {
      "root": "ml-model",
      "framework": "fastapi",
      "entrypoint": "serve:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "api" } }]
}
