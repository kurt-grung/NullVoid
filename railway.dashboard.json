{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && VITE_BASE=/ npm run dashboard:build"
  },
  "deploy": {
    "startCommand": "npx --yes serve@14 packages/dashboard/dist -s -l ${PORT:-3000}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
