{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":preserveSemverRanges"],
  "timezone": "Africa/Johannesburg",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 4,
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
  "packageRules": [
    {
      "description": "One weekly PR for all minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Major updates one PR each, never auto-merged",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "GitHub Actions grouped",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Python ML requirements grouped separately (retrain workflow validates them)",
      "matchManagers": ["pip_requirements"],
      "groupName": "ml-model python deps"
    },
    {
      "description": "Node runtime is pinned by the Railway check (engines 24.x); do not bump engines",
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ],
  "ignoreDeps": ["node"],
  "vulnerabilityAlerts": { "labels": ["security"] },
  "osvVulnerabilityAlerts": true
}
