{
  "name": "nullvoid-monorepo",
  "version": "2.1.0",
  "workspaces": [
    "packages/*",
    "ts"
  ],
  "packageManager": "npm@11.6.2",
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "description": "Detect malicious code",
  "scripts": {
    "build": "turbo run build --filter=!nullvoid-vscode",
    "build:watch": "cd ts && npm run build:watch",
    "dev": "cd ts && npm run dev",
    "test": "npm run test:ts && npm run test:api",
    "test:ts": "cd ts && npm test",
    "benchmark": "cd ts && npm run benchmark",
    "test:api": "npm run test -w @nullvoid/api",
    "test:unit": "cd ts && npm run test:unit",
    "test:integration": "cd ts && npm run test:integration",
    "test:performance": "cd ts && npm run test:performance",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:dashboard",
    "test:e2e:api": "npm run test -w @nullvoid/api -- --testPathPatterns=scan-lifecycle",
    "test:e2e:dashboard": "playwright test -c packages/dashboard/playwright.config.ts",
    "test:watch": "cd ts && npm run test:watch",
    "test:coverage": "cd ts && npm run test:coverage --",
    "scan": "node ts/dist/scan.js",
    "scan:dev": "cd ts && npm run scan:dev",
    "ml:serve": "node ts/dist/bin/nullvoid.js serve --port 8000",
    "ml:train": "node ts/dist/bin/nullvoid.js train --input train.jsonl --output-dir .",
    "ml:eval": "node ts/dist/bin/nullvoid.js eval --input train.jsonl --model .",
    "ml:eval-behavioral": "node ts/dist/bin/nullvoid.js eval-behavioral --input train-behavioral.jsonl --model .",
    "ml:split-train-val": "node ts/dist/bin/nullvoid.js split-train-val --input ml-model/train.jsonl --train-out ml-model/.eval-cache/train.jsonl --val-out ml-model/.eval-cache/val.jsonl --val-fraction 0.2 --seed 42 --time-val-newest --time-field exportedAt",
    "ml:train-heldout-cache": "node ts/dist/bin/nullvoid.js train-heldout-cache --input ml-model/.eval-cache/train.jsonl --output-dir ml-model/.eval-cache",
    "ml:eval-heldout-cache": "node ts/dist/bin/nullvoid.js eval-heldout-cache --input ml-model/.eval-cache/val.jsonl --model ml-model/.eval-cache --json --eval-set validation",
    "ml:heldout-dependency": "node ts/dist/bin/nullvoid.js heldout-dependency",
    "ml:dedup": "node ts/dist/bin/nullvoid.js dedup",
    "ml:export": "node ts/dist/bin/nullvoid.js export --out train.jsonl",
    "ml:export-behavioral": "node ts/dist/bin/nullvoid.js export-behavioral --out train-behavioral.jsonl",
    "ml:train-behavioral": "node ts/dist/bin/nullvoid.js train-behavioral --input train-behavioral.jsonl",
    "ml:feedback-export": "cd ml-model && node export-feedback.js --feedback feedback.jsonl --out train.jsonl",
    "ml:train-ensemble": "cd ml-model && python3 train-ensemble.py --input train.jsonl",
    "api:build": "turbo run build --filter=@nullvoid/api",
    "api:start": "turbo run build --filter=@nullvoid/api && node packages/api/dist/index.js",
    "dashboard:dev": "turbo run dev --filter=dashboard",
    "dashboard:build": "turbo run build --filter=dashboard",
    "ml:scan": "node ts/dist/bin/nullvoid.js scan",
    "badge": "node scripts/generate-badge.js",
    "badge:running": "node -e \"require('./scripts/generate-badge.js').setRunningBadge()\"",
    "badge:update": "npm run badge && git add README.md && git commit -m 'chore: Update dynamic test badge' || true",
    "lint": "npm run lint -w nullvoid && npm run lint -w dashboard",
    "lint:fix": "cd ts && npm run lint:fix",
    "format": "prettier --write \"ts/src/**/*.ts\"",
    "format:check": "prettier --check \"ts/src/**/*.ts\"",
    "type-check": "cd ts && npm run type-check",
    "ci:check": "bash scripts/ci-check.sh",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "malware",
    "detection",
    "scanner",
    "javascript",
    "nodejs",
    "npm",
    "package",
    "supply-chain",
    "wallet-hijacking",
    "obfuscation",
    "static-analysis",
    "cli",
    "typescript"
  ],
  "author": "NullVoid Team",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "ajv": "^6.15.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "ts/src/**/*.ts": [
      "prettier --write",
      "eslint --fix --config ts/eslint.config.mjs"
    ],
    "packages/dashboard/**/*.{ts,tsx}": [
      "eslint --fix --config packages/dashboard/eslint.config.js"
    ]
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "tar": "^7.5.7",
    "eslint": "^9.39.2",
    "qs": "6.17.1",
    "glob": "^14.0.3",
    "minimatch": "^11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurt-grung/NullVoid.git"
  },
  "bugs": {
    "url": "https://github.com/kurt-grung/NullVoid/issues"
  },
  "homepage": "https://github.com/kurt-grung/NullVoid#readme",
  "private": true
}
