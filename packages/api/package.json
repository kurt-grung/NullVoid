{
  "name": "@nullvoid/api",
  "version": "1.0.1",
  "description": "NullVoid REST API for scan management",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && nitro build",
    "start": "node start.mjs",
    "start:nitro": "node .output/server/index.mjs",
    "start:express": "node dist/index.js",
    "dev": "nitro dev",
    "dev:express": "ts-node src/index.ts",
    "pretest": "npm run build -w nullvoid",
    "test": "jest --runInBand --watchman=false",
    "test:nitro": "jest --runInBand --watchman=false -c jest.nitro.config.js",
    "nitro:build:vercel": "NITRO_PRESET=vercel nitro build"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^12.6.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "nullvoid": "*",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.35.0",
    "swagger-ui-express": "^5.0.1",
    "unstorage": "^2.0.0-beta.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nitro": "^3.0.261103-rc",
    "rolldown": "^1.3.2",
    "supertest": "^7.2.2"
  }
}
