{
  "name": "nullvoid",
  "version": "2.1.0",
  "description": "Detect malicious code",
  "main": "dist/scan.js",
  "types": "dist/types/index.d.ts",
  "bin": {
    "nullvoid": "./dist/bin/nullvoid.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/nullvoid.js",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/bin/nullvoid.ts",
    "test": "jest --maxWorkers=1 --watchman=false",
    "test:unit": "jest test/unit --watchman=false",
    "test:integration": "jest test/integration --watchman=false",
    "test:performance": "jest test/performance --watchman=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=2 --watchman=false",
    "benchmark": "ts-node --transpile-only benchmark/run.ts",
    "scan": "node dist/scan.js",
    "scan:dev": "ts-node src/scan.ts",
    "badge": "node ../scripts/generate-badge.js",
    "badge:running": "node -e \"require('../scripts/generate-badge.js').setRunningBadge()\"",
    "badge:update": "npm run badge && git add README.md && git commit -m 'chore: Update dynamic test badge' || true",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "cp ../README.md ../LICENSE . && npm run build",
    "postpack": "rm -f README.md LICENSE"
  },
  "keywords": [
    "security",
    "malware",
    "detection",
    "scanner",
    "javascript",
    "nodejs",
    "npm",
    "package",
    "supply-chain",
    "wallet-hijacking",
    "obfuscation",
    "static-analysis",
    "cli",
    "typescript"
  ],
  "author": "NullVoid Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "axios": "^1.13.5",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.1",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "semver": "^7.8.6",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node-fetch": "^2.6.13",
    "@types/semver": "^7.8.0",
    "@types/tar": "^6.1.13"
  },
  "optionalDependencies": {
    "redis": "^4.7.0"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurt-grung/NullVoid.git"
  },
  "bugs": {
    "url": "https://github.com/kurt-grung/NullVoid/issues"
  },
  "homepage": "https://github.com/kurt-grung/NullVoid#readme",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
